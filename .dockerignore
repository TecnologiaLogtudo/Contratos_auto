# =============================
# Docker build context
# =============================

# Git / editor metadata
.git/
.gitignore
.vscode/
.idea/

# Python cache
**/__pycache__/
**/*.py[cod]

# Ambientes e build local
.venv/
venv/
dist/
build/

# Frontend
**/node_modules/
web/node_modules/
web/dist/
frontend/node_modules/

# Artefatos e dados
backend/app/data/
*.db
.playwright-mcp/

# Temporários/artefatos locais
*.log
*.tmp
*.xlsx
*.xls
*_processado.xlsx
*_tmp*.xlsx

# Configs que devem ser injetadas via ENV ou volumes
config.ini
.env
